# Nothing here is required to run the app: demo mode works with no key and no API.
#
# Visitors add their own Anthropic key in the UI. It is sent per request in the
# x-anthropic-key header to the risk engine API and is never stored or logged.

# Where the browser finds the Python risk engine API (server/). It is used only for
# uploaded holdings and live analyst runs; the sample portfolio is bundled with the app.
# `pnpm dev` assumes http://localhost:8300 when this is unset. Leave it unset on a
# deployment that has no API attached: the app says so instead of failing.
NEXT_PUBLIC_API_URL=
