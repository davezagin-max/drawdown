# Nothing here is required: demo mode works with no key.
#
# Visitors add their own Anthropic key in the UI. It arrives per request in the
# x-anthropic-key header and is never stored or logged.
#
# ANTHROPIC_API_KEY + ALLOW_SERVER_KEY=1 are for LOCAL development and fixture
# recording only. Never set ALLOW_SERVER_KEY on a public deployment.
ANTHROPIC_API_KEY=
ALLOW_SERVER_KEY=
# Comma-separated frontend origins allowed to call this API.
ALLOWED_ORIGINS=http://localhost:3300
# Optional: a Parquet file of prices fetched for personal use (see scripts/fetch_prices.py).
# Unset, the bundled simulated prices are used. Never point a public deployment at real data.
DRAWDOWN_PRICES=
