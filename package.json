{
  "name": "drawdown",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3300",
    "dev:api": "cd server && uv run uvicorn app.main:app --reload --port 8300",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write .",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "smoke": "vitest run tests/kit/smoke.live.test.ts",
    "record": "cd server && uv run python scripts/record.py && uv run python scripts/export_demo.py",
    "export": "cd server && uv run python scripts/export_demo.py",
    "screenshots": "node scripts/screenshot.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "^0.170.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.170.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "playwright": "^1.64.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@11.24.0"
}
